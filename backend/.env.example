ENVIRONMENT=development
DEBUG=true

# PostgreSQL — replace with your real credentials
DATABASE_URL=postgresql+asyncpg://ciphertrade:CHANGE_ME@localhost:5432/ciphertrade

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_STRING

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173"]

LOG_LEVEL=INFO

# ── Blockchain (Phase 5) ──────────────────────────────────────────────────────
# Deployed CipherTradeEscrow contract address on local Anvil (chain 31337)
ESCROW_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
ESCROW_CONTRACT_ABI_PATH=../contracts/out/CipherTradeEscrow.sol/CipherTradeEscrow.json
WEB3_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
